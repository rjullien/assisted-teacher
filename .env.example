# ── Hermes (Lya) ──────────────────────────────────────────────────────────────
# URL et clé du gateway Hermes/Lya
HERMES_URL=http://hermes-lya.openclaw.svc.cluster.local:8642
HERMES_API_KEY=

# ── Pi agent (mode Rédaction) ─────────────────────────────────────────────────
# Interrupteur maître. Sans "true", pas de bouton Pi, pas de route /ws/agent/pi.
PI_ENABLED=false
# Chemin vers le binaire pi (installé globalement dans l'image Docker)
PI_CMD=pi
# Fichier models.json rendu au boot par entrypoint.sh
PI_MODELS_JSON=/data/pi-config/models.json
# Clé Bifrost (utilisée pour rendre models.json — TrimSpace appliqué)
BIFROST_API_KEY=

# ── Legacy (docker-compose local, non utilisé en prod) ───────────────────────
# ACP_AGENT_CMD="opencode-ai acp"
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
# OPENCODE_BASE_URL=http://your-llm-gateway:8080/v1

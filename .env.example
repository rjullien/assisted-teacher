# ── Hermes / Lya (modes Desk et Lya) ────────────────────────────────────────
# Backend → POST $HERMES_URL/v1/chat/completions
# Auth: Authorization: Bearer $HERMES_API_KEY
#
# En prod (Infisical), HERMES_API_KEY doit être EXACTEMENT la même valeur que
# API_SERVER_KEY du pod hermes-lya (path typique: /agents/hermes-lya).
# Un mismatch → "hermes auth failed (HTTP 401): Invalid gateway API key".
#
# PIÈGE VÉRIFIÉ : Hermes valide API_SERVER_KEY depuis le fichier PVC
# /opt/data/.env, PAS depuis l'env K8s/Infisical du pod. Les deux divergent
# après un rotate Infisical, donc des secrets identiques dans Kubernetes ne
# prouvent PAS que la clé correspond. Voir README.
HERMES_URL=http://hermes-lya.openclaw.svc.cluster.local:8642
HERMES_API_KEY=

# ── Agent pi (mode Pi) ──────────────────────────────────────────────────────
# Interrupteur maître. Vaut "true" par défaut dans l'image Docker, donc le
# mode Pi s'active sans rien ajouter côté manifest Kubernetes.
PI_ENABLED=true
# Binaire pi (installé globalement dans l'image)
PI_CMD=pi
# Doivent correspondre à la clé de provider et au champ `name` du modèle
# écrits dans $HOME/.pi/agent/models.json par entrypoint.sh.
PI_PROVIDER=bifrost
PI_MODEL=bifrost-default
# Identifiant de modèle envoyé à Bifrost (le `id`, qui contient une barre
# oblique — c'est pourquoi PI_MODEL cible le `name` et pas l'`id`).
PI_MODEL_ID=opencode-go/deepseek-v4-flash
# Endpoint LLM de pi. Défaut intégré à l'image : Bifrost intra-cluster.
BIFROST_URL=http://bifrost.openclaw.svc.cluster.local:8080/v1
# Optionnelle : Bifrost est sans auth depuis le cluster. Si renseignée, la clé
# est trimmée et un header Authorization est envoyé.
BIFROST_API_KEY=

# ── Legacy ACP subprocess (configuration morte, lue par aucun code) ─────────
# ACP_AGENT_CMD="opencode-ai acp"
# ACP_AGENT_CMD="openclaw acp"
# ACP_AGENT_CMD="kiro-cli acp"
# ACP_AGENT_CMD="hermes acp"
